      "ssl": "disable",
      "sshTunnel": false
    }
  },
  {
    "id": "AnthropicAcct001",
    "name": "Anthropic account",
    "type": "anthropicApi",
    "data": {
      "apiKey": "={{ $env.ANTHROPIC_API_KEY }}"
    }
  }
]
