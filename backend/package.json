{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "Small Node.js API for Postgres database access",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "knex": "tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts",
    "migrate:make": "npm run knex -- migrate:make -x ts",
    "migrate:up": "npm run knex -- migrate:latest",
    "migrate:down": "npm run knex -- migrate:rollback",
    "migrate:status": "npm run knex -- migrate:status",
    "migrate:list": "npm run knex -- migrate:list",
    "seed:make": "npm run knex -- seed:make",
    "seed:run": "npm run knex -- seed:run",
    "data:download": "node ../data/oulad/download.js",
    "data:sample": "node ../data/oulad/sample.js",
    "data:full": "npm run data:download && npm run data:sample && npm run seed:run"
  },
  "dependencies": {
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
