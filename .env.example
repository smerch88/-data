# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=appdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Backend
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5433/appdb

# pgAdmin (browser at http://localhost:5050)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Bind host for docker-compose port mappings.
# Local dev: leave empty → 0.0.0.0 (default), services accessible on host.
# VPS / production: BIND_HOST=127.0.0.1 — services only reachable from
#   localhost so a reverse-proxy (Caddy/Nginx) terminates TLS at the edge.
BIND_HOST=

# VPS connection (used by vps-operator agent + infra/vps/vps-run.sh).
# Filled by /vps-bootstrap or manually.
VPS_HOST=
VPS_USER=
VPS_PORT=
VPS_PASSWORD=

# Public domain for the deployed pgAdmin (used by infra/caddy/Caddyfile).
# Set on VPS only. Empty locally.
PUBLIC_DOMAIN=
PUBLIC_EMAIL=
