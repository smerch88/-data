# Postgres
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=appdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Backend
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5433/appdb

# pgAdmin (browser at http://localhost:5050)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
# Stable SECRET_KEY for pgAdmin Flask sessions. Must NOT change between
# container restarts, otherwise existing browser cookies become invalid and
# users get a 500 NoneType crash on the next request.
# Generate a fresh value per environment with: openssl rand -hex 32
PGADMIN_SECRET_KEY=

# n8n (AI multi-agent orchestration — Dmytro's workflows)
# Local: leave these unset → editor at http://localhost:5678, no TLS.
# VPS: N8N_HOST=n8n.<domain>, N8N_PROTOCOL=https,
#      N8N_PUBLIC_URL=https://n8n.<domain>, and a real encryption key:
#        openssl rand -hex 32
# N8N_ENCRYPTION_KEY MUST NOT change after first start, otherwise every
# saved n8n credential becomes undecryptable.
N8N_HOST=
N8N_PROTOCOL=
N8N_PUBLIC_URL=
N8N_PORT=5678
N8N_ENCRYPTION_KEY=
TZ=Europe/Kyiv

# Anthropic API key for the n8n AI agents (Observer/Analyst/Strategy/
# Communicator). VPS only — never commit. The n8n "Anthropic account"
# credential references it as {{ $env.ANTHROPIC_API_KEY }}.
ANTHROPIC_API_KEY=

# Bind host for docker-compose port mappings.
# Local dev: leave empty → 0.0.0.0 (default), services accessible on host.
# VPS / production: BIND_HOST=127.0.0.1 — services only reachable from
#   localhost so a reverse-proxy (Caddy/Nginx) terminates TLS at the edge.
BIND_HOST=

# VPS connection (used by vps-operator agent + infra/vps/vps-run.sh).
# Filled by /vps-bootstrap or manually.
VPS_HOST=
VPS_USER=
VPS_PORT=
VPS_PASSWORD=

# Public domain for the deployed pgAdmin (used by infra/caddy/Caddyfile).
# Set on VPS only. Empty locally.
PUBLIC_DOMAIN=
PUBLIC_EMAIL=
